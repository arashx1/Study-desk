# Set these in the terminal environment or .env before starting the backend.
# For Groq: MODEL_BASE_URL=https://api.groq.com/openai/v1 and MODEL_NAME=openai/gpt-oss-120b
# For Gemini: MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai and MODEL_NAME=gemini-3.8-flash
# For OpenAI: MODEL_BASE_URL=https://api.openai.com/v1 and MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=
MODEL_NAME=openai/gpt-oss-120b
MODEL_BASE_URL=https://api.groq.com/openai/v1

# Published ClaimReview lookup (optional)
GOOGLE_FACTCHECK_API_KEY=

# Optional task-specific providers. Blank fields use MODEL_* defaults.
# If BASE_URL is set, supply that task's own API_KEY (keys are not shared across hosts).
ANSWER_API_KEY=
ANSWER_MODEL_NAME=
ANSWER_BASE_URL=
SUMMARY_API_KEY=
SUMMARY_MODEL_NAME=
SUMMARY_BASE_URL=
CHECK_API_KEY=
CHECK_MODEL_NAME=
CHECK_BASE_URL=

# Optional external evidence discovery; independent of the model provider
BRAVE_SEARCH_API_KEY=
