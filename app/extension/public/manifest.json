{"manifest_version": 3, "name": "Scholar's Desk", "version": "0.2.0", "minimum_chrome_version": "116", "description": "A calm workspace for saved research, source-linked notes, and returning to your work.", "permissions": ["activeTab", "scripting", "contextMenus", "sidePanel", "storage", "tabs", "alarms"], "host_permissions": ["http://127.0.0.1:8765/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "background.js", "type": "module"}, "action": {"default_title": "Open Scholar's Desk"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "side_panel": {"default_path": "index.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}